#!/usr/bin/env python3
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from urllib.parse import parse_qs, urlparse
import json, os, re, subprocess, time
HOST=os.environ.get('CLAUDE_OUTPUT_VIEWER_HOST','127.0.0.1'); PORT=int(os.environ.get('CLAUDE_OUTPUT_VIEWER_PORT','7683')); CLIENT_RE=re.compile(r'^ccw-[a-z0-9]{12}$')
def clamp(v):
    try: n=int(v)
    except Exception: return 3500
    return max(200,min(n,12000))
def capture(client,lines):
    if not CLIENT_RE.match(client or ''): return {'ok':False,'error':'invalid_client','output':'','ts':time.time()}
    session=f'claude-code-web-{client}'; env=os.environ.copy(); env['HOME']=os.environ.get('CLAUDE_WEB_HOME','/home/claudeuser'); env['TERM']=env.get('TERM','xterm-256color')
    proc=subprocess.run(['tmux','capture-pane','-p','-J','-t',f'{session}:0.0','-S',f'-{lines}','-E','-'],stdout=subprocess.PIPE,stderr=subprocess.PIPE,text=True,env=env,timeout=3)
    if proc.returncode: return {'ok':False,'error':proc.stderr.strip() or 'capture_failed','session':session,'output':'','ts':time.time()}
    output='\n'.join(line.rstrip() for line in proc.stdout.replace('\x00','').splitlines()).rstrip()+'\n'
    return {'ok':True,'session':session,'output':output,'lines':lines,'ts':time.time()}
class Handler(BaseHTTPRequestHandler):
    def log_message(self,fmt,*args): return
    def send_json(self,payload,status=200):
        body=json.dumps(payload,ensure_ascii=False).encode('utf-8'); self.send_response(status); self.send_header('Content-Type','application/json; charset=utf-8'); self.send_header('Cache-Control','no-store'); self.send_header('Content-Length',str(len(body))); self.end_headers(); self.wfile.write(body)
    def do_GET(self):
        parsed=urlparse(self.path)
        if parsed.path!='/capture': self.send_json({'ok':False,'error':'not_found'},404); return
        qs=parse_qs(parsed.query); self.send_json(capture(qs.get('client',[''])[0],clamp(qs.get('lines',['3500'])[0])))
if __name__=='__main__': ThreadingHTTPServer((HOST,PORT),Handler).serve_forever()
