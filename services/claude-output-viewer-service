HOME = os.environ.get('CLAUDE_WEB_HOME', '/home/claudeuser')
SESSIONS_DIR = os.path.join(HOME, '.claude', 'sessions')
PROJECTS_DIR = os.path.join(HOME, '.claude', 'projects')
WEB_SESSIONS_DIR = os.path.join(HOME, '.claude', 'web-sessions')
