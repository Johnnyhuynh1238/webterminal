[Unit]
Description=Claude Code web terminal via ttyd
After=network.target
[Service]
Type=simple
User=claudeuser
Group=claudeuser
Environment=HOME=/home/claudeuser
Environment=SHELL=/bin/bash
Environment=PATH=/home/claudeuser/.nvm/versions/node/v22.22.1/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ExecStart=/usr/bin/ttyd -i 127.0.0.1 -p 7681 -b /claude -a -I /usr/local/share/claude-code-ttyd/index.html -t fontSize=16 -t cursorBlink=true -t scrollback=20000 -t disableLeaveAlert=true /usr/local/bin/claude-web-terminal
Restart=on-failure
RestartSec=2
NoNewPrivileges=yes
[Install]
WantedBy=multi-user.target
